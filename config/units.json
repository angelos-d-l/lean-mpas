  "generated": {
    "lean_build_info": {
      "group": "base",
      "after": "src/run/lean_namelist.f90",
      "path": "generated/lean_build_info.f90",
      "why": "written by configure: the executable's flavor, switches, build identity and the system's errno accessor."
    }
  },
  "gpu_only": {
    "base": ["src/phys_fault.f90", "src/lean_warp.f90"],
    "noahmp_lean": ["src/nvmath.f90"],
    "model": ["src/phys_check.f90"],
    "driver": ["src/device/radiation_device_tables.f90", "src/device/radiation_fast_data.f90", "src/device/radiation_fast_gas.f90", "src/device/radiation_fast.f90", "src/device/mynn_card.f90", "src/phys_dev.f90"]
  },
  "gpu_only_why": "files only the card build compiles; radiation_device_tables exists only in src/device",
  "device_overrides": [
    "thompson", "state", "gf_state", "gwdo_state", "noahmp_coupling", "noahmp", "mynn_shared", "mynn_surface",
    "mynn_pbl_helpers", "mynn_pbl", "mynn_conversions", "mynn", "gf_core", "gf", "gwdo_core", "gwdo",
    "physics_inputs", "physics_tendency", "sea_ice_noah", "sea_ice", "land_ice_exchange",
    "radiation_device_tables", "radiation_ozone", "radiation_climatology", "radiation_prepare", "radiation_cloud",
    "radiation_sw_kernels", "radiation_sw", "radiation_lw_kernels", "radiation_lw", "radiation_column",
    "dyn_tend", "dyn_acoustic", "dyn_diagnostics", "dyn_scalars", "dyn_boundary"
  ],
  "device_overrides_why": "for the card, src/device/<name>.f90 replaces src/<name>.f90. The five dyn_* files are hand-kept, as mynn_card and radiation_fast: the card's kernel forms (one thread per (level, point), values recomputed where read), while src/dyn_*.f90 keep the CPU's loop order (neighbour loop outside, level loop inside, values in arrays). The generators neither write nor check them, so ./lean generate --check does not see them; a change to a dynamics kernel is made in both files.",
  "cmake_preprocess": {
    "gpu": ["src/lean_model.f90", "src/dyn_micro.f90"],
    "switched": [
      "third_party/mpas-8.4.2/src/framework/mpas_constants.F",
      "third_party/mpas-8.4.2/src/core_atmosphere/physics/physics_wrf/module_mp_radar.F",
      "src/dyn_micro.f90",
      "src/radiation_blcloud.f90", "src/lean_model.f90"
    ]
  },
  "cmake_preprocess_why": "files CMake preprocesses itself (Fortran_PREPROCESS ON: an -E step, then the compile of its output). Plain builds keep the target list: gpu lean_model and dyn_micro (the Thompson stages, card only), cpu empty. Any explicit switch (including off) adds the switched list, filtered to compiled sources after conditional selection and device overrides. It covers every guarded use/module, in either branch: CMake's raw-source module scan does not know the -D compile options. noahmp_lean/<Name>.f90 names a generated split file relative to the build directory; all other paths are relative to the repo. noahmp_core itself is never compiled. tests/lean_cli/test_config.py test_every_hidden_use_is_preprocessed checks all guards and compiled split pieces."
}
