<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="hourly" type="output" filename_template="hourly.$Y.nc" output_interval="stream:diagnostics:output_interval" ></stream><stream name="diagnostics" type="output" filename_template="diagnostics.$Y.nc" output_interval="3:00:00" ></stream><stream name="reader" type="input" filename_template="reader.nc" input_interval="stream:surface:input_interval"/><stream name="surface" type="input" filename_template="surface.nc" input_interval="3:00:00"/>
</streams>
