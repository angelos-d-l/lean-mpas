<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="hourly" type="output" filename_template="g.$G.nc" output_interval="none" ></stream>
<stream name="reader" type="input" filename_template="r.$G.nc" input_interval="none" ></stream>
</streams>
