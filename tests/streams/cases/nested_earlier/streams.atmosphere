<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="early" type="output" filename_template="early.nc" output_interval="1:00:00"><var name="q2"/></stream>
<stream name="a" type="output" filename_template="a.nc" output_interval="1:00:00"><var name="theta"/><stream name="early"/><stream name="a"/></stream>
</streams>
