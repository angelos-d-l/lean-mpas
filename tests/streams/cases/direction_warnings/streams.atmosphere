<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="hourly" type="output" filename_template="hourly.$Y.nc" output_interval="1:00:00" input_interval="none"></stream><stream name="reader" type="input" filename_template="r.nc" input_interval="none" output_interval="none"/>
</streams>
