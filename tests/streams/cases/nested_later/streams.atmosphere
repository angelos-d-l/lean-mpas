<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="a" type="output" filename_template="a.nc" output_interval="1:00:00"><var name="theta"/><stream name="later" packages="limited_area"/></stream>
<stream name="later" type="output" filename_template="later.nc" output_interval="1:00:00"><var name="q2"/><var name="theta"/><var_array name="scalars"/><var_struct name="lbc"/></stream>
</streams>
