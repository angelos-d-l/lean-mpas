<streams>
<immutable_stream name="input" type="input" filename_template="init.$Y-$M-$D_$h.$m.$s.nc" input_interval="initial_only"/>
<stream name="hourly" type="output" filename_template="hourly.$Y.nc" output_interval="1:00:00" filename_interval="6:00:00" clobber_mode="append" io_type="netcdf4" precision="double" reference_time="2026-11-08_06:00:00" record_interval="1:00:00" packages="limited_area;iau"><var name="theta"/><var_array name="scalars"/><var_struct name="diag"/><file name="list.hourly"/><stream name="input" packages="limited_area"/></stream>
</streams>
